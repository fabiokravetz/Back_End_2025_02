<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Produto</title>
</head>
<link rel="stylesheet" href="/css/style.css">
<body>
    <h1>Editar Produto</h1>

    <form action="/atualizar/<%= produto.id %>" method="POST">
        <label for="nome">Nome:</label>
        <input type="text" id="nome" name="nome" value="<%= produto.nome %>" required>
        
        <label for="preco">Preço:</label>
        <input type="number" step="0.01" id="preco" name="preco" value="<%= produto.preco %>" required>
        
        <label for="descricao">Descrição:</label>
        <textarea id="descricao" name="descricao"><%= produto.descricao %></textarea>
        
        <button type="submit">Atualizar Produto</button>
    </form>
    <a href="/">Voltar para a Lista</a>
</body>
</html>