<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>Painel de Gerenciamento de Dados</h1>
        
        <h2>Olá, <%= username %>!</h2>

        <h3>Inserir Item</h3>
        <form action="/paginaProtegida/inserir" method="POST" class="form-insercao">
            <div>
                <label for="nome">Nome:</label>
                <input type="text" id="nome" name="nome" required>
            </div>
            <div>
                <label for="descricao">Descrição (Opcional):</label>
                <textarea id="descricao" name="descricao"></textarea>
            </div>
            <button type="submit">Adicionar Item</button>
        </form>
        <hr>

        <h3>Itens Cadastrados</h3>
        <% if (items && items.length > 0) { %>
            <!--<table border="1" style="width:100%; text-align: left;">-->
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>Criação</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach(function(item) { %>
                        <tr>
                            <td><%= item.id %></td>
                            <td><%= item.nome %></td>
                            <td><%= item.descricao || '(Sem descrição)' %></td>
                            <!--Recomendável fazer a formatação via código SQL - Usar DATE_FORMAT()-->
                            <td><%= new Date(item.criacao).toLocaleString('pt-BR') %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p>Nenhum item cadastrado!</p>
        <% } %>

        <hr>
        
        <a href="/logout">Fazer Logout</a>
        <br>
        <a href="/">Voltar à Página Inicial</a>

    </div>
</body>
</html>